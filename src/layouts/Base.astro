---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
}

const { title, description, ogTitle = title } = Astro.props;

const SITE = "https://ismailbahloul.com";
const canonical = new URL(Astro.url.pathname, SITE).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Ismaïl Bahloul",
  jobTitle: "Ingénieur systèmes Linux & DevOps",
  url: SITE,
  email: "mailto:ismail@ismailbahloul.com",
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "ESEO — École Supérieure d'Électronique de l'Ouest",
  },
  sameAs: [
    "https://github.com/ismail-bahloul",
    "https://www.linkedin.com/in/ismail-bahloul",
  ],
  knowsAbout: [
    "Linux",
    "Active Directory",
    "DevOps",
    "Automatisation",
    "Docker",
    "CI/CD",
    "C",
    "Rust",
    "Python",
  ],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b0b0b" />
    <link rel="icon" href="/favicon.png" sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ismaïl Bahloul" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ismaïl Bahloul — ingénieur systèmes Linux & DevOps" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og.png`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <main class="page">
      <slot />
    </main>
  </body>
</html>
