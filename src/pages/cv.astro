---
import Base from "../layouts/Base.astro";

const contenu = [
  "Profil et disponibilité immédiate en Île-de-France",
  "Expériences : freelance (automatisation, IA, VPS Linux), Assurance Maladie / CNAM (Active Directory, PRA, Azure), stage R&D en Espagne",
  "Formation : diplôme d'ingénieur ESEO, Cloud, Systèmes & Sécurité",
  "Projets open source : driver ALSA, TouchDesigner-Linux, TuxMix",
  "Compétences : systèmes, virtualisation, CI/CD et IaC, scripting, réseaux, supervision, sécurité",
  "Langues et certifications (TOEIC 835, Voltaire)",
];
---

<Base
  title="CV"
  description="CV d'Ismaïl Bahloul, ingénieur systèmes Linux & DevOps — une page, en PDF, lisible par les ATS."
>
  <div class="wrap">
    <div class="page-head">
      <h1>CV</h1>
      <p class="lead">
        Une page, à jour, générée depuis la même source que mes candidatures.
        Le PDF contient une couche de texte propre : les logiciels de recrutement
        le lisent correctement.
      </p>
      <div class="actions">
        <a class="btn btn--primary" href="/cv.pdf">Télécharger le PDF</a>
        <a class="btn" href="mailto:ismail@ismailbahloul.com">Me contacter</a>
      </div>
    </div>

    <section aria-labelledby="contenu" style="padding-top: 8px">
      <div class="section-head">
        <h2 id="contenu">Ce que contient le CV</h2>
      </div>
      <div class="prose">
        <ul>
          {contenu.map((ligne) => (
            <li>{ligne}</li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="versions" style="padding-top: 8px">
      <div class="section-head">
        <h2 id="versions">Versions</h2>
      </div>
      <div class="prose">
        <p>
          Le CV est décliné par marché : <strong>CDI Île-de-France</strong>,
          <strong>remote</strong>, <strong>Maroc</strong> et
          <strong>intérim</strong>. La version publiée ici est celle du CDI en
          Île-de-France, qui est le positionnement actuel.
        </p>
        <p>
          Pour une candidature précise, j'adapte le document à l'offre : les
          mêmes faits, réordonnés et reformulés — jamais inventés.
        </p>
      </div>
    </section>

    <section aria-labelledby="contact-cv" style="padding-top: 8px">
      <div class="section-head">
        <h2 id="contact-cv">Contact</h2>
      </div>
      <div class="contact-list">
        <a href="mailto:ismail@ismailbahloul.com">ismail@ismailbahloul.com</a>
        <a href="https://github.com/ismail-bahloul">github.com/ismail-bahloul</a>
        <a href="https://www.linkedin.com/in/ismail-bahloul">in/ismail-bahloul</a>
      </div>
    </section>
  </div>
</Base>
