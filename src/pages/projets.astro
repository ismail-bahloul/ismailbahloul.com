---
import Base from "../layouts/Base.astro";

const projets = [
  {
    id: "babyface",
    titre: "babyface-pro-linux",
    sous: "Un driver noyau pour la RME Babyface Pro FS",
    tags: ["C", "ALSA", "linux-kernel", "USB", "reverse engineering"],
    probleme:
      "La RME Babyface Pro FS fonctionne en mode USB propriétaire, plus riche que le mode class-compliant — mais <code>snd-usb-audio</code> ne gère pas ce mode. Sous Linux, la carte reste bridée.",
    fait: [
      "Module <code>snd-usb-babyface-pro</code> écrit de zéro en C, intégré au sous-système ALSA.",
      "Rétro-ingénierie du protocole USB propriétaire de la carte.",
      "Validation sur matériel réel : checkpatch et sparse propres, 41 tests sur 41, latence mesurée à 0,67 ms.",
    ],
    resultat:
      "Soumis en RFC v6 sur la liste de diffusion du noyau (ALSA) pour intégration upstream.",
    lien: "https://github.com/ismail-bahloul/babyface-pro-linux",
  },
  {
    id: "touchdesigner",
    titre: "TouchDesigner-Linux",
    sous: "TouchDesigner sur Linux, toutes distributions",
    tags: ["Wine", "packaging", "GitHub Actions", "creative coding"],
    probleme:
      "TouchDesigner n'existe officiellement que pour Windows et macOS. Sous Linux, il faut assembler Wine, les dépendances, les patches et les icônes à la main — un après-midi perdu à chaque mise à jour.",
    fait: [
      "Installeur en une commande, patches Wine maintenus, icônes et fichiers .desktop.",
      "Tests et CI GitHub Actions pour que l'installation ne casse pas au fil des versions.",
    ],
    resultat:
      "141 étoiles : un projet repris par la communauté TouchDesigner sous Linux.",
    lien: "https://github.com/ismail-bahloul/TouchDesigner-Linux",
  },
  {
    id: "tuxmix",
    titre: "TuxMix",
    sous: "Le mixeur des interfaces RME, natif sous Linux",
    tags: ["Rust", "iced", "ALSA", "PipeWire", "audio"],
    probleme:
      "TotalMix, le mixeur interne des interfaces RME, n'existe que sous Windows et macOS. Le driver noyau règle l'audio, pas le routage.",
    fait: [
      "Mixeur natif Linux écrit en Rust (iced), sur ALSA et PipeWire — GUI et TUI.",
      "Trois vues (Quick, Mixer, Matrix) et le DSP complet : préampli, trim, EQ, width, loopback, groupes mute/solo.",
      "Snapshots, undo/redo, nommage des canaux, survie au rebranchement. Protocole rétro-conçu et validé sur matériel réel ; paquet AUR.",
    ],
    resultat:
      "Babyface Pro FS supportée aujourd'hui ; l'objectif est d'étendre aux autres modèles RME.",
    lien: "https://github.com/ismail-bahloul/TuxMix",
  },
  {
    id: "dotfiles",
    titre: "dotfiles",
    sous: "Une machine reproductible, pas une machine qui marche",
    tags: ["Arch / CachyOS", "chezmoi", "VFIO", "PipeWire"],
    probleme:
      "Reconstruire une machine à l'identique — dual-boot, GPU passthrough, chaîne audio pro, gestion des ventilateurs — prend des jours si rien n'est versionné.",
    fait: [
      "Setup CachyOS (Arch) entièrement reproductible avec chezmoi : KDE Plasma 6 sous Wayland, dual-boot Windows 11, passthrough VFIO.",
      "Chaîne PipeWire pro-audio, gestion de l'alimentation et des ventilateurs par profil secteur/batterie, initramfs allégé.",
      "install.sh pour amorcer, validate.sh qui vérifie que chaque pièce est réellement en place.",
    ],
    resultat:
      "Une machine détruite puis reconstruite en une commande, et une documentation des réglages qui ont demandé de la mesure.",
    lien: "https://github.com/ismail-bahloul/dotfiles",
  },
  {
    id: "pipeline",
    titre: "Pipeline d'acquisition automatisé",
    sous: "Client e-commerce · étude de cas anonymisée",
    tags: ["n8n", "Python", "API LLM", "Stripe", "Supabase", "VPS Linux"],
    probleme:
      "Le client traitait à la main environ cinq opérations par jour : prospecter, produire les visuels, envoyer les liens de paiement, commander au fournisseur, gérer les litiges.",
    fait: [
      "Sept workflows n8n orchestrés de bout en bout : collecte de prospects, visuels produit générés par IA, emails avec lien de paiement Stripe, commande automatique au fournisseur, gestion des litiges et remboursements.",
      "Intégration d'API tierces, monitoring et correction d'incidents en production, sur un VPS Linux.",
    ],
    resultat:
      "Environ 50 opérations par jour, soit un gain d'environ ×10, en autonomie complète.",
    lien: null,
  },
];
---

<Base
  title="Projets"
  description="Driver noyau ALSA, TouchDesigner-Linux, TuxMix, dotfiles reproductibles et pipelines automatisés — les projets d'Ismaïl Bahloul."
>
  <div class="wrap">
    <div class="page-head">
      <h1>Projets</h1>
      <p class="lead">
        Des choses que j'ai construites, avec le problème de départ, ce que j'ai
        fait, et ce que ça donne. Le code est public, sauf mention contraire.
      </p>
    </div>

    {projets.map((p) => (
      <article class="article" id={p.id}>
        <h2>{p.titre}</h2>
        <p class="sub">{p.sous}</p>

        <ul class="tags">
          {p.tags.map((t) => (
            <li>{t}</li>
          ))}
        </ul>

        <div class="prose">
          <p><span class="label">Le problème</span><span set:html={p.probleme}></span></p>

          <p style="margin-bottom: 6px">
            <span class="label">Ce que j'ai fait</span>
          </p>
          <ul>
            {p.fait.map((f) => (
              <li set:html={f}></li>
            ))}
          </ul>

          <p class="result">{p.resultat}</p>
        </div>

        {p.lien ? (
          <p class="note" style="font-style: normal">
            <a href={p.lien}>github.com/ismail-bahloul/{p.titre} ↗</a>
          </p>
        ) : (
          <p class="note">
            Code et identité du client privés. Détails techniques disponibles sur
            demande.
          </p>
        )}
      </article>
    ))}
  </div>
</Base>
